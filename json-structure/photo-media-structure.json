{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/google-places/refs/heads/main/json-structure/photo-media-structure.json",
  "name": "PhotoMedia",
  "description": "A reference to a place photo's media URI.",
  "type": "object",
  "properties": {
    "name": {
      "description": "The resource name of the photo media.",
      "example": "places/ChIJN1t_tDeuEmsRUsoyG83frY4",
      "type": "string"
    },
    "photoUri": {
      "description": "A short-lived URI to the photo bytes.",
      "example": "https://places.googleapis.com/v1/places/ChIJ/photos/AeJ/media",
      "type": "uri"
    }
  }
}