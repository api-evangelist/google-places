        {
          "id": "cc791c7d-3db1-4762-9510-76bf5d070bf8",
          "name": "Google Places Get Place Photo",
          "request": {
            "name": "Google Places Get Place Photo",
            "description": {
              "content": "Retrieve a photo for a place. The photo is referenced by the photo resource name returned in a Place Details, Nearby Search, or Text Search response. Returns the photo media or a redirect to the image bytes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "places",
                ":placeId",
                "photos",
                ":photoName",
                "media"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "maxHeightPx",
                  "value": "<integer>",
                  "description": "Maximum desired height of the image in pixels (1-4800)."
                },
                {
                  "disabled": false,
                  "key": "maxWidthPx",
                  "value": "<integer>",
                  "description": "Maximum desired width of the image in pixels (1-4800)."
                },
                {
                  "disabled": false,
                  "key": "skipHttpRedirect",
                  "value": "<boolean>",
                  "description": "If true, returns a JSON response with the photo URI instead of redirecting."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "placeId",
                  "description": "(Required) The unique place identifier."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "photoName",
                  "description": "(Required) The photo resource reference returned in a place's photos array (the segment following photos/)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "692c5096-fb35-47bb-9133-d80910f57378",
              "name": "The photo media response, or a JSON photo reference when skipHttpRedirect is true.",
              "originalRequest": {
